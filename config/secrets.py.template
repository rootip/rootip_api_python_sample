# このテンプレートファイルを「secrets.py」というファイル名で保存し、各情報を入力してください
#
# 【セキュリティ上の注意】
# - このファイル（secrets.py）は .gitignore によりGitへ登録されない設定になっています。
#   誤ってコミット・公開しないよう、`git status` に secrets.py が表示されないことを確認してください。
# - APIトークンやパスワードを、AIチャット・プロンプト・スクリーンショット・
#   ソースコード・メール等へ貼り付けないでください。
# - APIトークンが漏えいした可能性がある場合は、rootipの画面から速やかに失効・再発行してください。
# - クライアント証明書ファイル（p12/pem）はこのリポジトリのフォルダの外に保存することを推奨します。

# rootipのユーザID（ログイン時に使用するメールアドレス形式のユーザID）
ROOTIP_USER_ID = ""

# rootipのURL（例 https://xxx.rootip-cloud.net）
# ※https:// の公式ホストのみ使用できます。独自ドメイン契約ではrootipサポートへ確認してください
ROOTIP_URL = ""

# rootipで発行したAPIトークン
ROOTIP_API_KEY = ""

# rootipのクライアント証明書情報
# p12かpem形式か、いずれか一方を設定ください
# フォルダ区切りは/（半角スラッシュ）をご利用ください（円マーク、バックスラッシュはエラーになります）

# rootipのクライアント証明書（p12形式）へのファイルパスとパスワード
ROOTIP_CLIENT_CERTIFICATE_P12 = ""
ROOTIP_CLIENT_CERTIFICATE_P12_PASSWORD = ""

# rootipのクライアント証明書（PEM形式）へのファイルパス
# PEM形式の作成方法はAPIリファレンスをご参照ください
ROOTIP_CLIENT_CERTIFICATE_PEM = ""

# 【通常は変更不要】社内プロキシ等の環境で独自のCA証明書が必要な場合のみ、
# 情報システム部門から提供されたCA証明書（PEM形式）のパスを設定してください
# TLS証明書エラーが出ても、コード側の検証を無効化（verify=False）しないでください
ROOTIP_CA_BUNDLE = ""
